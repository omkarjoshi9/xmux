# Copy to .env; replace placeholders. Never commit the resulting .env.
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql://xmux:replace-with-random-local-password@127.0.0.1:55432/xmux
REDIS_URL=redis://127.0.0.1:56379/0
XMUX_ENV=development
AUTH_REGISTRY_FILE=
CURSOR_SECRET=
MULTIPLEXER_URL=http://127.0.0.1:58002
MULTIPLEXER_TOKEN=
GATEWAY_URL=http://127.0.0.1:58003
GATEWAY_TOKEN=
JWT_ISSUER=
JWT_AUDIENCE=xmux-orchestrator
JWT_PUBLIC_KEY_FILE=
METRICS_TOKEN=
# Configure only verified multiplexer endpoint paths.
MULTIPLEXER_SELECTION_PATH=
MULTIPLEXER_RECONCILE_PATH=
MULTIPLEXER_RESULT_PATH=
# MCP starts explicitly with the compose mcp profile after provisioning OAuth.
XMUX_MCP_ISSUER=
XMUX_MCP_RESOURCE=
XMUX_MCP_API_URL=
MULTIPLEXER_REGISTRY_URL=
MULTIPLEXER_CANCEL_PATH=
MULTIPLEXER_CANCEL_STATUS_PATH=
GATEWAY_DELIVERY_PATH=
GATEWAY_DELIVERY_STATUS_PATH=
MULTIPLEXER_SCHEDULE_CAPABILITIES_PATH=
MULTIPLEXER_SCHEDULE_CREATE_PATH=
MULTIPLEXER_SCHEDULE_LOOKUP_PATH=
# 0 disables development throttling; production default is 120.
REQUESTS_PER_MINUTE=120

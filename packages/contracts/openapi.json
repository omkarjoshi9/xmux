                  "$ref": "#/components/schemas/Common/$defs/Reference"
                },
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true
              }
            },
            "required": [
              "schema_version",
              "remote_ref",
              "finished_at",
              "status",

              },
              "agent_id": {
                "$ref": "#/components/schemas/Common/$defs/Reference"
              },
              "correlation_id": {
                "$ref": "#/components/schemas/Common/$defs/Uuid"
              },
              "checked_at": {
                "$ref": "#/components/schemas/Common/$defs/UtcTimestamp"
              },
              "outcome": {
                "const": "FOUND"
              },
              "remote_ref": {
                "$ref": "#/components/schemas/RemoteTaskRef"
              }
            },
            "required": [
              "schema_version",
              "task_id",
              "agent_id",
              "correlation_id",
              "checked_at",
              "outcome",
              "remote_ref"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema_version": {
                "type": "string",

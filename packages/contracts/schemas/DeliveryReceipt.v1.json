{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "delivery_id": {
      "format": "uuid",
      "title": "Delivery Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "sent",
        "failed",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    }
  },
  "required": [
    "delivery_id",
    "state"
  ],
  "title": "DeliveryReceipt",
  "type": "object"
}

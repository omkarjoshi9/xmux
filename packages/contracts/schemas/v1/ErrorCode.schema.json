{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmux.example/contracts/v1/ErrorCode.schema.json",
  "title": "ErrorCode",
  "description": "Closed draft v1 error vocabulary. HTTP mappings live in conventions/http.json; tests prevent drift. Codes do not authorize retries.",
  "type": "string",
  "enum": [
    "malformed_json",
    "unsupported_schema_version",
    "invalid_request",
    "invalid_cursor",
    "unauthenticated",
    "forbidden",
    "not_found",
    "idempotency_conflict",
    "invalid_state_transition",
    "approval_required",
    "approval_expired",
    "result_pending",
    "remote_outcome_unknown",
    "payload_too_large",
    "unsupported_media_type",
    "validation_failed",
    "unsupported_capability",
    "cancellation_unsupported",
    "content_unavailable",
    "rate_limited",
    "internal_error",
    "auth_failed",
    "remote_failure",
    "unavailable",
    "remote_unavailable"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmux.example/contracts/v1/TaskPage.schema.json",
  "title": "TaskPage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "https://xmux.example/contracts/v1/TaskStatus.schema.json"
      },
      "maxItems": 100
    },
    "next_cursor": {
      "anyOf": [
        {
          "$ref": "https://xmux.example/contracts/v1/Common.schema.json#/$defs/Cursor"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "items",
    "next_cursor"
  ]
}

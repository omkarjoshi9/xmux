{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmux.example/contracts/v1/TaskReceipt.schema.json",
  "title": "TaskReceipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "task_id": {
      "$ref": "https://xmux.example/contracts/v1/Common.schema.json#/$defs/Uuid"
    },
    "status": {
      "$ref": "https://xmux.example/contracts/v1/Common.schema.json#/$defs/TaskState"
    },
    "assigned_agent": {
      "anyOf": [
        {
          "$ref": "https://xmux.example/contracts/v1/Common.schema.json#/$defs/Reference"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "status",
    "assigned_agent"
  ]
}

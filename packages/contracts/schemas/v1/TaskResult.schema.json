{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmux.example/contracts/v1/TaskResult.schema.json",
  "title": "TaskResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "task_id": {
      "$ref": "https://xmux.example/contracts/v1/Common.schema.json#/$defs/Uuid"
    },
    "result_refs": {
      "type": "array",
      "items": {
        "$ref": "https://xmux.example/contracts/v1/Common.schema.json#/$defs/Reference"
      },
      "maxItems": 100,
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "result_refs"
  ]
}
